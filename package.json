{
  "name": "fragmarket",
  "private": true,
  "version": "0.0.1",
  "description": "Class marketplace dapp — YODA + skin NFTs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "node:local": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/MarketSkinsModule.ts --network localhost",
    "deploy:edr": "hardhat ignition deploy ignition/modules/MarketSkinsModule.ts --network hardhatMainnet",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/MarketSkinsModule.ts --network sepolia"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.2",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "chai": "^5.3.3",
    "hardhat": "^3.0.4",
    "mocha": "^11.7.2",
    "typescript": "~5.8.0",
    "vite": "^5.4.10"
  }
}
